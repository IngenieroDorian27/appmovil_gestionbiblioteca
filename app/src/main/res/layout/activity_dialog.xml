<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="40dp"
    android:background="@color/color11"
    tools:context=".menubiblioteca.crud.DialogActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvTituloNombre"
                android:text="@string/NombreLibro"
                android:textColor="@color/color2"
                android:textSize="40dp"
                android:textStyle="bold"
                >
            </TextView>


        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTituloAutor"
            android:text="@string/DatoM"
            android:maxLines="3"
            android:layout_marginTop="4dp"
            android:textSize="40dp"
            android:textColor="@color/color1"
            >
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTituloCategoria"
            android:text="@string/DatoM"
            android:maxLines="3"
            android:layout_marginTop="4dp"
            android:textSize="40dp"
            android:textColor="@color/color1"
            >
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTituloFecha"
            android:text="@string/DatoM"
            android:maxLines="3"
            android:layout_marginTop="4dp"
            android:textSize="40dp"
            android:textColor="@color/color1"
            >
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTituloIsbn"
            android:text="@string/DatoM"
            android:maxLines="3"
            android:layout_marginTop="4dp"
            android:textSize="40dp"
            android:textColor="@color/color1"
            >
        </TextView>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>