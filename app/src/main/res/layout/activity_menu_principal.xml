<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/color11"
    android:paddingHorizontal="15dp"
    android:paddingVertical="20dp"
    tools:context=".menubiblioteca.MenuPrincipalActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvAgregarLibro"
        android:layout_width="170dp"
        android:layout_height="170dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@color/color2"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            >

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/library_add"
                android:layout_marginBottom="5dp"
                app:tint = "@color/color5"
                >
            </ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvSpinner"
                android:text="@string/AgregarC"
                android:textColor="@color/color8"
                android:textStyle="bold"
                android:textAllCaps="true"
                >
            </TextView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvEditarLibro"
        android:layout_width="170dp"
        android:layout_height="170dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvAgregarLibro"
        app:cardBackgroundColor="@color/color2"
        android:layout_marginTop="20dp"
        >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            >

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/settingslibrary"
                app:tint = "@color/color5"
                android:layout_marginBottom="5dp"
                >
            </ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvList"
                android:text="@string/ModificarC"
                android:textColor="@color/color8"
                android:textAllCaps="true"
                android:textStyle="bold"
                >
            </TextView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvRevisarLibro"
        android:layout_width="170dp"
        android:layout_height="170dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvEditarLibro"
        app:cardBackgroundColor="@color/color2"
        android:layout_marginTop="20dp"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            >

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/previewlibrary"
                app:tint = "@color/color5"
                android:layout_marginBottom="5dp"
                >
            </ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvGrid"
                android:text="@string/Visualizar"
                android:textColor="@color/color8"
                android:textStyle="bold"
                android:textAllCaps="true"
                >
            </TextView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Biblioteca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvRevisarLibro"
        android:textSize="35dp"
        android:textStyle="bold"
        android:textColor="@color/color4"
        android:layout_marginTop="20dp"
        >
    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>